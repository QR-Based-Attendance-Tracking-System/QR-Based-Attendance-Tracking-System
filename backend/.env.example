# PostgreSQL connection (set DATABASE_PASSWORD through your secret manager)
DATABASE_URL=jdbc:postgresql://localhost:5432/qr_attendance_db
DATABASE_USERNAME=qr_attendance_app
DATABASE_PASSWORD=

# Use false only for local HTTP development. Production must use HTTPS and true.
APP_SECURITY_COOKIE_SECURE=false
APP_SECURITY_ALLOWED_ORIGINS=http://localhost:3000

# Required to enable public sign-up; use distinct random values per role.
APP_STUDENT_REGISTRATION_CODE=
APP_LECTURER_REGISTRATION_CODE=
